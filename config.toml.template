# 默认路由与运行参数（http_proxy 才是出站网络代理）
active_upstream = "woagent"
active_plan = ""
active_proxy_upstream = "__forbid__"
active_effort = "auto"

# 请求策略
retry_count = 3
request_timeout_secs = 120

# 数据保留
request_retention_hours = 8
session_max_count = 200
session_delete_after_days = 0

# 服务商：连接地址、认证与协议
providers = [
    { name = "woagent", url = "https://ai.woagent.net", protocols = ["chat_completions"], token = "sk-your-key" },
    { name = "anthropic", url = "https://api.anthropic.com", token = "sk-ant-..." },
    { name = "deepseek", url = "https://api.deepseek.com/anthropic", token = "sk-..." },
]

# 可选账号：provider 通过 account 引用
accounts = []

# 路由方案：default 为兜底，high / mid / low 为可选覆盖
upstreams = [
    { name = "woagent", default = { provider = "woagent", model = "KM-kimi-k2.6" } },
    { name = "deepseek-pro", low = { model = "deepseek-v4-flash" }, default = { provider = "deepseek", model = "deepseek-v4-pro" } },
    { name = "deepseek", mid = { model = "deepseek-v4-flash" }, low = { model = "deepseek-v4-flash" }, default = { provider = "deepseek", model = "deepseek-v4-pro" } },
    { name = "deepseek-flash", default = { provider = "deepseek", model = "deepseek-v4-flash" } },
    { name = "anthropic-fable", high = { model = "claude-fable" }, low = { model = "claude-haiku" }, default = { provider = "anthropic", model = "claude-sonnet" }, effort = "high" },
    { name = "anthropic-sonnet5", default = { provider = "anthropic", model = "claude-sonnet5" } },
    { name = "anthropic", high = { model = "claude-opus" }, low = { model = "claude-haiku" }, default = { provider = "anthropic", model = "claude-sonnet" } },
    { name = "mix", high = { provider = "anthropic", model = "claude-opus" }, low = { model = "deepseek-v4-flash" }, default = { provider = "deepseek", model = "deepseek-v4-pro" } },
]

# 模型映射与价格：[输入、输出、缓存写入、缓存读取]，USD / 百万 token
model_pricing = [
    { id = "KM-kimi-k2.6", price = [0.0, 0.0], providers = { woagent = ["KM-kimi-k2.6"] } },
    { id = "claude-fable", price = [10.0, 50.0, 12.5, 1.0], providers = { anthropic = ["claude-fable-5"] } },
    { id = "claude-opus", price = [5.0, 25.0, 6.25, 0.5], providers = { anthropic = ["claude-opus-4-8"] } },
    { id = "claude-sonnet5", price = [3.0, 15.0, 3.75, 0.3], providers = { anthropic = ["claude-sonnet-5"] } },
    { id = "claude-sonnet", price = [3.0, 15.0, 3.75, 0.3], providers = { anthropic = ["claude-sonnet-4-6"] } },
    { id = "claude-haiku", price = [0.8, 4.0, 1.0, 0.08], providers = { anthropic = ["claude-haiku-4-5"] } },
    { id = "deepseek-v4-pro", price = [0.4286, 0.8571, 0.4286, 0.0036], providers = { deepseek = [] } },
    { id = "deepseek-v4-flash", price = [0.1429, 0.2857, 0.1429, 0.0029], providers = { deepseek = [] } },
]

[server]
listen_address = "127.0.0.1"
http_port = 5000
proxy_port = 8888
ws_include_bodies = false

[logging]
level = "info"
